# Kopiere diese Datei nach ".env" und trage deine Keys ein.
# Leere Keys = Funktion wird nicht genutzt (es gibt Fallbacks).

# --- Claude (Skript, Bildbeschreibungen, Caption) – Pflicht ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Stimme: ElevenLabs (optional; ohne Key wird Piper genutzt) ---
ELEVENLABS_API_KEY=
# Voice-ID aus deiner ElevenLabs Voice Library (deutsche Stimme wählen)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Stimme: Piper (kostenlos, offline) ---
PIPER_MODEL=models/de_DE-thorsten-high.onnx
# >1.0 = langsamer sprechen (hilft, wenn das Video zu kurz ist)
PIPER_LENGTH_SCALE=1.0

# --- Bilder ---
PEXELS_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high  (high ist teurer)
OPENAI_IMAGE_QUALITY=medium

# --- Untertitel ---
SUBTITLE_FONT=Arial Black
